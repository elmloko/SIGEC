<script>
    $(document).ready(function () {

        $("#form").submit(function (event) {
            event.preventDefault();
        });
    });

    $('#entidades').on('change', function () {

        var prefijo_externo_entidad = $(this).find(':selected').attr('prefijo');
        var gestion_seleccionada = $('#gestiones option:selected').val();

        var prefijo_hoja_de_ruta = prefijo_externo_entidad + gestion_seleccionada + '-';
        $('#prefijo-hoja-de-ruta').text(prefijo_hoja_de_ruta);
    });

    $('#gestiones').on('change', function () {

        var prefijo_externo_entidad = $('#entidades option:selected').attr('prefijo');
        var gestion_seleccionada = $(this).val();

        var prefijo_hoja_de_ruta = prefijo_externo_entidad + gestion_seleccionada + '-';
        $('#prefijo-hoja-de-ruta').text(prefijo_hoja_de_ruta);
    });

    function onclickButtonBuscar() {

        var prefijo_hoja_de_ruta = $('#prefijo-hoja-de-ruta').text();
        var nro_hoja_de_ruta = $('#hoja-de-ruta').val();
        var hoja_de_ruta = prefijo_hoja_de_ruta + nro_hoja_de_ruta;
        var id_entidad_seleccionada = $('#entidades option:selected').val();
        var gestion_seleccionada = $('#gestiones option:selected').val();

        var prefijo_externo_entidad = $('#entidades option:selected').attr('prefijo');

        //console.log('prefijo_externo_entidad: ' + prefijo_externo_entidad);
        //console.log('prefijo_hoja_de_ruta: ' + prefijo_hoja_de_ruta);
        //console.log('nro_hoja_de_ruta: ' + nro_hoja_de_ruta);
        /*
         console.log('hoja_de_ruta: ' + hoja_de_ruta);
         console.log('entidad_seleccionada: ' + id_entidad_seleccionada);
         console.log('gestion_seleccionada: ' + gestion_seleccionada);
         */

        // ProgressDialog
        $(document).ready(function () {
            $(document).ajaxStart(function () {
                $('#wait').show();
            });
            $(document).ajaxStop(function () {
                $('#wait').hide();
            });
            $(document).ajaxError(function () {
                $('#wait').hide();
            });
        });

        $.ajax({
            url: '/externo/buscarHojaDeRuta',
            data: {
                hoja_de_ruta: hoja_de_ruta,
                id_entidad_seleccionada: id_entidad_seleccionada,
                gestion_seleccionada: gestion_seleccionada
            },
            type: 'POST',
            dataType: 'json',
            success: function (data) {
                var json = JSON.parse(JSON.stringify(data));

                var trHTML = '';
                $.each(json, function (i, item) {
                    trHTML +=
                        '<tr>' +
                        '<td><a href="/externo/seguimientoExterno/?hr=' + item.nur + '">' + item.nur + '</a></td>' +
                        '<td><b>' + item.nombre_destinatario + '</b><br>' + item.cargo_destinatario + '</td>' +
                        '<td><b>' + item.nombre_remitente + '</b><br>' + item.cargo_remitente + '</td>' +
                        '<td>' + item.referencia + '</td>' +
                        '<td>' + item.fecha_creacion + '</td>' +
                        '<td>' + item.estado + '</td>' +
                        '<td><a href="/externo/seguimientoExterno/?hr=' + item.nur + '" title="Ver seguimiento" class="text-success text-xl"><i class="md md- md-verified-user "></i></a></td>' +
                        '</tr>';
                });
                $('#table-resultados > tbody').append(trHTML);

                var cantidad_de_resultados = Object.keys(json).length;
                $('#cantidad-de-resultados').text('Resultados: ' + cantidad_de_resultados);

                //console.log("json: " + JSON.stringify(json));
                //console.log("json.rows: " + json.rows);
                //console.log("resultado: " + json.resultado);
            },
            error: function (xhr, status) {
                //alert(status);
                console.log("status: " + status);
                console.log("xhr: " + xhr);
            }
        });

        $('#table-resultados tbody > tr').remove();
    }
</script>
</body>
</html>