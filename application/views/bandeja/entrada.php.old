<!-- === OBSERVACION DE 'RECHAZO DE DERIVACION' === -->
<script>
    $(document).ready(function () {
        $(".btn-modal-rechazo").click(function (event) {

            console.log('id-seguimiento:', $(this).data('id-seguimiento'));
            console.log('id-seguimiento-padre:', $(this).data('id-seguimiento-padre'));
            console.log('nur:', $(this).data('nur'));
            console.log('id-usuario:', $(this).data('id-usuario'));
            console.log('estado:', $(this).data('estado'));

            var id_seguimiento = $(this).data('id-seguimiento');
            var id_seguimiento_padre = $(this).data('id-seguimiento-padre');
            var nur = $(this).data('nur');
            var id_usuario = $(this).data('id-usuario');
            var estado = $(this).data('estado');

            $(".id_seguimiento").val(id_seguimiento);
            $(".id_seguimiento_padre").val(id_seguimiento_padre);
            $(".nur").val(nur);
            $(".id_user").val(id_usuario);
            $(".estado").val(estado);

            //$('#modal-rechazo').modal('show');
            // sobrepone el modal sobre el <body>
            $('#modal-rechazo').appendTo("body").modal('show');
        });
    });

    function guardar_rechazo() {
        var id_seguimiento = $('.id_seguimiento').val();
        var id_seguimiento_padre = $('.id_seguimiento_padre').val();
        var nur = $('.nur').val();
        var observacion = $('.texto-rechazo').val();
        var id_user = $('.id_user').val();
        var estado = $('.estado').val();

        console.log('id_seguimiento:', id_seguimiento);
        console.log('id_seguimiento_padre:', id_seguimiento_padre);
        console.log('nur:', nur);
        console.log('observacion:', observacion);
        console.log('id_user:', id_user);
        console.log('estado:', estado);

        if (observacion.length > 0) {

            $.ajax({
                type: "POST",
                data: {
                    id_seguimiento: id_seguimiento,
                    id_seguimiento_padre: id_seguimiento_padre,
                    nur: nur,
                    observacion: observacion,
                    id_usuario: id_user,
                    estado: estado,
                },
                url: "/ajax/rechazar_derivacion",
                // dataType: "html",
                success: function (data) {
                    location.reload(true);
                }
            });

        }
        else {
            alert("(*) Usted debe llenar una descripción del rechazo");
        }

        $('.texto-rechazo').val('');
        $('#modal-rechazo').modal('toggle');


    }
</script>

<!-- === FIN OBSERVACION DE 'RECHAZO DE DERIVACION' === -->


