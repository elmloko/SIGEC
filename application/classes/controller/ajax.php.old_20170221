    public function action_jsonVerificarIdUsuarioPuedaAsignarPlazos($id)
        // $id_usuario_logueado, $id_usuario_destinatario)
        //$id_usuario_logueado = null, $id_usuario_destinatario = null)
    {
        $id_usuario_logueado = $_GET['id_usuario_logueado'];
        $id_usuario_destinatario = $_GET['id_usuario_destinatario'];

        //echo $id_usuario_logueado;
        //echo $id_usuario_destinatario;

        $query = " SELECT
                        IF(COUNT(*) > 0, 'SI', 'NO') AS respuesta
                    FROM
                        usuarios_habilitados_plazos
                    WHERE
                        (id_usuario_padre = '$id_usuario_logueado')
                            AND (id_usuario_hijo = '$id_usuario_destinatario');";

        $resultSet = db::query(Database::SELECT, $query, FALSE)
            ->execute()
            ->as_array();

        // echo $query;

        header('Content-Type: application/json');
        echo json_encode($resultSet);
    }

