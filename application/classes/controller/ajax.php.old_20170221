<?php

defined('SYSPATH') or die('No direct script access.');

class Controller_Ajax extends Controller
{

    protected $user;

    public function before()
    {
        $auth = Auth::instance();
        //si el usuario esta logeado entocnes mostramos el menu
        if ($auth->logged_in()) {
            //$session = Session::instance();
            //$this->user = $session->get('auth_user');
            $this->user = $auth->get_user();
            parent::before();
        } else {
            $this->request->redirect('/login');
        }
    }

    //grafica documentos generados por el usuario
    public function action_misdocumentos()
    {
        $user = $this->user->id;
        $mDocumentos = new Model_Documentos();
        $documentos = $mDocumentos->generados($user);
        echo json_encode($documentos, JSON_NUMERIC_CHECK);
    }

    public function action_grafica()
    {
        $user = $this->user->id;
        $mDocumentos = new Model_Documentos();
        $actividad = $mDocumentos->actividad($user);
        $derivados = $mDocumentos->derivados($user);
        $result = array();
        $data1 = array();
        $data2 = array();
        foreach ($actividad as $a) {
            $data1[] = array(
                $a['time'],
                $a['cantidad']
            );
        }
        foreach ($derivados as $a) {
            $data2[] = array(
                $a['time'],
                $a['cantidad']
            );
        }
        $result[] = array(
            "label" => "Correspondencia Derivada",
            "data" => array_values($data2),
            "last" => true
        );
        $result[] = array(
            "label" => "Documentos Generados",
            "data" => array_values($data1),
            "last" => true
        );

        echo json_encode($result, JSON_NUMERIC_CHECK);
    }

    //hojas de ruta
    public function action_hojaruta()
    {
        $like = $_GET['q'];
        $mHojaruta = new Model_Hojasruta();
        $hrs = $mHojaruta->hojaruta($like);
        $result = array();
        foreach ($hrs as $h) {
            $result[] = array(
                'id' => $h['nur'],
                'text' => $h['nur'],
                //'data'=>$h['nur']
            );
        }
        echo json_encode(array('items' => $result), JSON_NUMERIC_CHECK);
    }

//recibir correspondencia
    public function action_recibir()
    {
        if ($this->request->is_ajax()) {
            $id = $_POST['id'];
            $seguimiento = ORM::factory('seguimiento')
                ->where('id', '=', $id)
                ->and_where('derivado_a', '=', $this->user->id)
                ->and_where('estado', '=', 1)
                ->find();
            if ($seguimiento->loaded()) {
                $seguimiento->fecha_recepcion = date('Y-m-d H:i:s');
                $seguimiento->estado = 2; //2=pendiente oficial
                if ($seguimiento->save()) {
                    $result = array(
                        'estado' => 'ok'
                    );
                } else {
                    $result = array(
                        'estado' => '',
                        'error' => 'Ocurrio un error al intentar recibir la correspondencia'
                    );
                }
                //guardamos en vitacora
                //$this->save($this->user->id_entidad, $this->user->id, $this->user->nombre . ' | <b>' . $this->user->cargo . '</b> Recepciono la hoja de ruta ' . $seguimiento->nur);
            } else {
                $result = array(
                    'estado' => '',
                    'error' => 'Ocurrio un error al intentar recibir la correspondencia'
                );
            }
            echo json_encode($result);
        }
    }

    public function action_documentosjson()
    {
        $session = Session::instance();
        $user = $session->get('auth_user');
        $xTable = $_POST['x-table'];
        $data = array();
        /// set order
        if (isset($xTable['order_column']) && isset($xTable['order_type'])) {
            $order = " ORDER BY " . mysql_real_escape_string($xTable['order_column']) . " " . mysql_real_escape_string($xTable['order_type']);
        }
        // row per page
        $rowPerPage = (isset($xTable['record_per_page'])) ? (int)$xTable['record_per_page'] : 20;
        // page index
        $pageIndex = ((int)$xTable['page_index'] > 0) ? (int)$xTable['page_index'] : 1;
        // offset
        $offset = ($pageIndex - 1) * $rowPerPage;
        // limit
        $limit = " LIMIT " . $offset . "," . $rowPerPage;

        $where_ini = " WHERE d.id_user='" . $user->id . "'";
        $strAnd = '';

        $conditions = $_POST['x-table']['conditions'];

        // create sql conditions
        if (isset($conditions['cite_original']) && strlen(trim($conditions['cite_original'])) > 0) {
            $where .= $strAnd . " d.cite_original = '" . mysql_real_escape_string($conditions['cite_original']) . "' ";
            $strAnd = " AND ";
        }
        if (isset($conditions['nur']) && strlen(trim($conditions['nur'])) > 0) {
            $where .= $strAnd . " nur = '" . mysql_real_escape_string($conditions['rating']) . "' ";
            $strAnd = " AND ";
        }
        if (isset($conditions['nombre_destinatario']) && strlen(trim($conditions['nombre_destinatario'])) > 0) {
            $where .= $strAnd . " nombre_destinatario like '%" . mysql_real_escape_string($conditions['nombre_destinatario']) . "%' ";
            $strAnd = " AND ";
        }
        if (isset($conditions['referencia']) && strlen(trim($conditions['referencia'])) > 0) {
            $where .= $strAnd . " referencia = '" . mysql_real_escape_string($conditions['referencia']) . "' ";
            $strAnd = " AND ";
        }
        if (isset($conditions['tipo']) && strlen(trim($conditions['tipo'])) > 0) {
            $where .= $strAnd . " t.tipo = '" . mysql_real_escape_string($conditions['tipo']) . "' ";
            $strAnd = " AND ";
        }

        if (strlen($where) > 0) {
            $where_ini = $where_ini . $where;
        }
        $sql = "SELECT "
            . "d.cite_original,CONCAT(d.nombre_destinatario,'<br/><b> ',d.cargo_destinatario,'</b>') as nombre_destinatario,d.nur,d.referencia,d.estado, t.tipo,d.fecha_creacion  "
            . "FROM documentos d "
            . "INNER JOIN tipos t ON d.id_tipo=t.id " . $where . $order . $limit;

        $mDocumentos = new Model_Documentos();
        $result = $mDocumentos->ejecutarsql_object($sql);
        //echo json_encode($result);


        $data = array();
        $sql2 = 'SELECT COUNT(*) AS total FROM documentos d' . $where_ini;
        $result_total = $mDocumentos->ejecutarsql_array($sql2);
        $total = $result_total[0]['total'];
        foreach ($result as $row) {
            $data[] = array(
                'cite_original' => '<b>' . $row->cite_original . '</b>',
                'nur' => $row->nur,
                'id_tipo' => $row->tipo,
                'nombre_destinatario' => $row->nombre_destinatario,
                'referencia' => $row->referencia,
                'estado' => utf8_encode($row->estado)
            );
        }
        $totalPage = ceil($total / $rowPerPage);

// build return data to x-table
        $var = array();
        $var['rows'] = $data;
        $var['total_page'] = $totalPage;
        $var['total_row'] = $total;
        $var['page_index'] = $pageIndex;
        $var['offset'] = $offset + 1;
        $var['row_per_page'] = $rowPerPage;
        header('Content-Type: application/json');
// json encode return data
//var_dump($var);
        echo json_encode($var, JSON_FORCE_OBJECT);
    }

